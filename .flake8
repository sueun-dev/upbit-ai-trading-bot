[flake8]
# black (line-length 88) is the authoritative formatter, so flake8 does not
# re-check line length: every line black leaves long is an unsplittable string
# literal (prompts, URLs, log templates). flake8 focuses on logic/lint issues.
# E203/W503/E704 conflict with black's formatting.
max-line-length = 88
extend-ignore = E203, W503, E704, E501
exclude =
    .git,
    __pycache__,
    .venv,
    build,
    dist
